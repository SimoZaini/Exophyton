# Database — Postgres (Neon / Vercel Postgres).
# Both URLs are injected automatically when you attach Vercel Postgres / Neon
# to the project. Locally, point both to the same Neon connection string
# (or a local docker `postgres:16`).
POSTGRES_PRISMA_URL="postgres://user:pass@host/db?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
# On Vercel, set to your deployment URL (e.g. https://equityia.vercel.app).
# Locally: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# One-shot seed endpoint (/api/admin/seed). Set to a long random string;
# only requests with the matching Bearer token will seed data.
SEED_TOKEN="change-me-to-a-long-random-string"
